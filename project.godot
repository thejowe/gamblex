; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Casino Pixel"
run/main_scene="res://scenes/lobby_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.0745, 0.1059, 0.149, 1)
boot_splash/show_image=false

[autoload]

SteamManager="*res://autoloads/steam_manager.gd"
NetworkManager="*res://autoloads/network_manager.gd"
AudioManager="*res://autoloads/audio_manager.gd"

[display]

window/size/viewport_width=900
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

environment/defaults/default_clear_color=Color(0.0745, 0.1059, 0.149, 1)
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
